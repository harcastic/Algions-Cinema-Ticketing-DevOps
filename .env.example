# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Single-node replica set required for transactions)
MONGODB_URI=mongodb://localhost:27017/cinema_ticketing?replicaSet=rs0

# Seat Hold Configuration
HOLD_DURATION_MINUTES=3

# JWT & Authentication
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

